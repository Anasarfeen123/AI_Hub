# Copy to .env for local development.
#
# Local dev only: Vite serves the client on :5173 while the API runs on :4000,
# so the client needs the API's absolute URL.
#
# Leave this UNSET in production — the server serves the built client from the
# same origin, and an empty value makes the client use relative paths.
VITE_API_URL=http://localhost:4000
